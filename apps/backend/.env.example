# Application Configuration
PROJECT_NAME="StudyMate AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & Secrets (generate a random 64-char string for production)
SECRET_KEY="generate-a-strong-secret-key-for-development"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL 16)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# Note: Use the dedicated least-privilege application role (studymate_app), NOT the postgres superuser.
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="studymate_app"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_DB="studymate_db"
DATABASE_URL="postgresql+asyncpg://studymate_app:your_secure_password_here@localhost:5432/studymate_db"

# Storage Configuration (Local disk for development)
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./uploads/documents"

# Configurable AI Provider (Backend-only, never client-exposed)
PRIMARY_AI_PROVIDER="gemini"
AI_MODEL_NAME="gemini-3.1-flash-lite"
AI_API_KEY="your_ai_provider_api_key_here"
AI_DAILY_BUDGET_LIMIT_USD=10.0
