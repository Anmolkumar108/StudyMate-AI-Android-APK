# StudyMate AI Mobile Environment Configuration Template
# Copy this file to .env to customize local network configuration.
#
# By default, leave EXPO_PUBLIC_API_URL commented out:
# - Android Emulator: Automatically connects to your backend host via http://10.0.2.2:8000.
# - Physical Android Device: Automatically detects your computer's Metro host IP.
# - iOS Simulator / Web: Automatically connects to http://localhost:8000.
#
# Only uncomment and set EXPO_PUBLIC_API_URL if you need to override the API target
# (e.g. testing on a physical device where Metro host auto-detection is not desired,
# or pointing to a remote staging server like https://api.studymate.ai).
#
# EXPO_PUBLIC_API_URL=http://<YOUR_PC_LAN_IP>:8000
